{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "../..",
    "paths": { "@/*": ["src/*"] },
    "typeRoots": ["/opt/npm-tools/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["stubs.d.ts", "stubs-modules.d.ts", "../../src/**/*.ts", "../../src/**/*.tsx", "../unit/*.ts"]
}
